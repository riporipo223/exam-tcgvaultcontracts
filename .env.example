#
# Copy to ".env" and fill values.
# Used by Hardhat network "bsctest" (chainId 97) + scripts/deployBscTestnet.ts
#
# -----------------------------------------------------------------------------
# WALLET REVIEW SHEET (French label → English → variable)
# -----------------------------------------------------------------------------
# | FR (revue)                    | EN (same meaning)              | Variable              |
# |-------------------------------|--------------------------------|------------------------|
# | Vault communautaire (USDC)    | Community protocol vault USDC  | VAULT_ADDRESS          |
# | Marketing & Structure         | Marketing & structure          | MARKETING_ADDRESS      |
# | Liquidité                     | Liquidity                      | LIQUIDITY_RECIPIENT    |
# | Burn / dead                   | (no wallet — see note below)   | —                      |
# | Récompenses communautaires    | Community rewards              | COMMUNITY_ADDRESS      |
# | Réserve de structuration 70k  | Structuring / team reserve     | TEAM_RECIPIENT         |
# -----------------------------------------------------------------------------
# Burn: TCGV burns reduce total supply in-contract; no recipient address in .env.
#      See contracts/docs/WALLET_ADDRESSES.md
# -----------------------------------------------------------------------------

# Hardhat bsctest RPC endpoint
BSCTEST_RPC_URL="https://YOUR_BSCTEST_RPC_URL"

# Tenderly RPC endpoint
TENDERLY_RPC_URL="https://rpc.tenderly.co/fork/YOUR_FORK_ID"

# Deployer private key used by Hardhat (do not commit real keys)
TCG_KEY="0xYOUR_PRIVATE_KEY"

# BscScan API key (required for verification)
BSC_SCAN_API_KEY="YOUR_BSCSCAN_API_KEY"

# --- Row 1: Community protocol vault (USDC) / FR: Vault communautaire (USDC) ---
VAULT_ADDRESS="0xYOUR_VAULT_ADDRESS"

# --- Row 2: Marketing & structure / FR: Marketing & Structure ---
MARKETING_ADDRESS="0xYOUR_MARKETING_ADDRESS"

# --- Row 5: Community rewards / FR: Récompenses communautaires ---
COMMUNITY_ADDRESS="0xYOUR_COMMUNITY_ADDRESS"

# InitialLaunch USDC treasury only (token presale; not Founder NFT). EN: presale USDC sink.
TREASURY_ADDRESS="0xYOUR_TREASURY_ADDRESS"

# --- Row 3: Liquidity / FR: Liquidité ---
# Founder NFT mint: 60% of USDC here (whitepaper). Also post-presale TCGV liquidity allocation.
LIQUIDITY_RECIPIENT="0xYOUR_LIQUIDITY_RECIPIENT"

# --- Row 6: Structuring reserve (e.g. 70k) / FR: Réserve de structuration ---
# Post-presale team vesting allocation.
TEAM_RECIPIENT="0xYOUR_TEAM_RECIPIENT"

# Operations & ecosystem: post-presale ops allocation + 10% Founder NFT USDC (whitepaper).
OPS_RECIPIENT="0xYOUR_OPS_RECIPIENT"

# Optional: if you already have a real 6-decimal USDC on BSC testnet, set it here.
# If omitted, the script deploys MockUSDC and (by default) mints 1,000,000 USDC to deployer.
USDC_ADDRESS=""

# Optional: set to 1 to skip TCGR + TCGRToTCGVConverter deployment
SKIP_TCGR="0"

# Optional: when deploying MockUSDC, set to 0 to mint 1,000,000 USDC to deployer (default is minting).
MOCK_USDC_MINT_DEPLOYER="1"

# Optional: wait time before each verification call
VERIFY_WAIT_SECONDS="30"

# Optional: deployBscTestnet — min stake in TCGV as a decimal string (parseEther; default 5000)
# BASIC_NFT_MIN_STAKE="5000"
